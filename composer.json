{
  "name": "super-admin-org/helpers",
  "description": "Helpers extension for super-admin",
  "type": "library",
  "keywords": [
    "super-admin",
    "helpers"
  ],
  "homepage": "https://super-admin.org/laravel/extension-helpers/",
  "support": {
    "docs": "https://super-admin.org/laravel/extension-helpers/",
    "issues": "https://github.com/super-admin-org/super-admin-helpers/issues",
    "source": "https://github.com/super-admin-org/super-admin-helpers"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "super-admin",
      "email": "talemulislam@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "super-admin-org/super-admin": "^1.0|^2.0"
  },
  "autoload": {
    "psr-4": {
      "SuperAdmin\\Admin\\Helpers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SuperAdmin\\Admin\\Helpers\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan admin:import helpers"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "SuperAdmin\\Admin\\Helpers\\HelpersServiceProvider"
      ]
    }
  }
}
